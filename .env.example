# DevAcademy Pro - Environment Variables Example
# Public variables (Client-side Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional AI endpoint override if running a custom proxy locally
# VITE_AI_ENDPOINT_URL=

# Server-Side Only Secrets (Supabase Edge Functions / Vault)
# DO NOT PREFIX WITH VITE_ - Never expose secrets to frontend client
AI_API_KEY=your_openai_or_gemini_api_key_here
